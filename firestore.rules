rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify current authenticated user matches userId
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile access rule
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Assessment test results subcollection
      match /testResults/{resultId} {
        allow read, write: if isOwner(userId);
      }

      // Saved careers subcollection
      match /savedCareers/{careerId} {
        allow read, write: if isOwner(userId);
      }

      // Career roadmap checklist progress
      match /roadmapProgress/{careerId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Health / connection test rule
    match /test/connection {
      allow read: if true;
    }
  }
}
