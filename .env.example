# ==============================================================================
# FindMyCareer Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Google Gemini API Key for AI Admissions Advisor & Live Search Grounding.
# You can obtain a free key at: https://aistudio.google.com/app/apikey
# Note: Developers can also provide their personal key directly in the UI without setting this.
GEMINI_API_KEY="your-gemini-api-key-here"

# PORT: Local and production web server port (default: 3000)
PORT=3000

# APP_URL: Host application URL (injected automatically in production)
APP_URL="http://localhost:3000"

